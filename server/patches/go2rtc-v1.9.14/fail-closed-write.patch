+
+// writeTCP preserves one complete RTSP/interleaved message or closes its transport.
+func (c *Conn) writeTCP(data []byte) (int, error) {
+	c.tcpWriteMu.Lock()
+	defer c.tcpWriteMu.Unlock()
+	if c.tcpWriteFailed {
+		return 0, io.ErrClosedPipe
+	}
+	if err := c.conn.SetWriteDeadline(time.Now().Add(Timeout)); err != nil {
+		c.tcpWriteFailed = true
+		_ = c.conn.Close()
+		return 0, err
+	}
+	n, err := c.conn.Write(data)
+	if err == nil && n != len(data) {
+		err = io.ErrShortWrite
+	}
+	if err != nil {
+		c.tcpWriteFailed = true
+		if c.writeDiagnostic.CompareAndSwap(false, true) {
+			log.Printf("[rtsp-write-audit] peer=%s written=%d expected=%d error=%q", c.conn.RemoteAddr(), n, len(data), err.Error())
+		}
+		// The read loop owns consumer cleanup; never invoke its callback in a sender.
+		_ = c.conn.Close()
+	}
+	return n, err
+}

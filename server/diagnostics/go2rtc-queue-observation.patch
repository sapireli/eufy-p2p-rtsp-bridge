+package rtsp
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// Counts only metadata; errors and partial writes retain upstream behavior.
+type writeObservation struct {
+	calls, bytes, errors, short, totalNs, maxNs atomic.Uint64
+}
+type writeObservationSnapshot struct {
+	Calls        uint64 `json:"calls"`
+	WrittenBytes uint64 `json:"written_bytes"`
+	Errors       uint64 `json:"errors"`
+	ShortWrites  uint64 `json:"short_writes"`
+	TotalNs      uint64 `json:"total_ns"`
+	MaxNs        uint64 `json:"max_ns"`
+}
+
+func (o *writeObservation) record(want, written int, elapsed time.Duration, err error) {
+	o.calls.Add(1)
+	o.bytes.Add(uint64(written))
+	if err != nil {
+		o.errors.Add(1)
+	}
+	if written != want {
+		o.short.Add(1)
+	}
+	ns := uint64(elapsed)
+	o.totalNs.Add(ns)
+	for old := o.maxNs.Load(); ns > old; old = o.maxNs.Load() {
+		if o.maxNs.CompareAndSwap(old, ns) {
+			break
+		}
+	}
+}
+func (o *writeObservation) snapshot() writeObservationSnapshot {
+	return writeObservationSnapshot{o.calls.Load(), o.bytes.Load(), o.errors.Load(), o.short.Load(), o.totalNs.Load(), o.maxNs.Load()}
+}

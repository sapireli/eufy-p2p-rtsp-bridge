+package core
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestQueueObservationDoesNotChangeDelivery(t *testing.T) {
+	old := ObserveTiming
+	defer func() { ObserveTiming = old }()
+	s := NewSender(&Media{}, &Codec{Name: CodecH264, PayloadType: 96})
+	for i := 0; i < 2; i++ {
+		s.Input(&Packet{Payload: []byte{byte(i)}})
+	}
+	ObserveTiming = false
+	b, _ := json.Marshal(s)
+	var j map[string]any
+	_ = json.Unmarshal(b, &j)
+	if _, ok := j["queued_packets"]; ok {
+		t.Fatal("diagnostic exposed while disabled")
+	}
+	ObserveTiming = true
+	b, _ = json.Marshal(s)
+	_ = json.Unmarshal(b, &j)
+	if j["queued_packets"] != float64(2) || j["queue_capacity"] != float64(4096) {
+		t.Fatal(string(b))
+	}
+	delivered := make(chan byte, 2)
+	s.Handler = func(p *Packet) { delivered <- p.Payload[0] }
+	s.Start()
+	for i := 0; i < 2; i++ {
+		select {
+		case v := <-delivered:
+			if v != byte(i) {
+				t.Fatal(v)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("delivery blocked")
+		}
+	}
+	s.Close()
+	s.Wait()
+}

+package rtsp
+
+import (
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+type observationConn struct {
+	net.Conn
+	bytes   []byte
+	written int
+	err     error
+}
+
+func (c *observationConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *observationConn) Write(p []byte) (int, error) {
+	c.bytes = append(c.bytes, p...)
+	return c.written, c.err
+}
+
+func TestObserveWritePreservesUpstreamResult(t *testing.T) {
+	old := core.ObserveTiming
+	defer func() { core.ObserveTiming = old }()
+	for _, enabled := range []bool{false, true} {
+		core.ObserveTiming = enabled
+		wire := &observationConn{written: 2, err: io.ErrClosedPipe}
+		c := &Conn{conn: wire}
+		err := c.writeInterleavedData([]byte("private-frame"))
+		if !errors.Is(err, io.ErrClosedPipe) || string(wire.bytes) != "private-frame" {
+			t.Fatal("result changed")
+		}
+		s := c.writeObservation.snapshot()
+		if enabled {
+			if s.Calls != 1 || s.WrittenBytes != 2 || s.Errors != 1 || s.ShortWrites != 1 {
+				t.Fatal(s)
+			}
+		} else if s.Calls != 0 {
+			t.Fatal(s)
+		}
+	}
+}

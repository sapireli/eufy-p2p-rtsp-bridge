# /etc/eufy-wall-bridge.env — login credentials for the bridge (chmod 600).
# /etc/eufy-wall-bridge.yaml contains startup options only. Configure cameras,
# LAN policy and transcoding from Android Shared bridge settings or Linux eufy-wall settings.
EUFY_EMAIL=wall@example.com
EUFY_PASSWORD=change-me
EUFY_COUNTRY=US
#BRIDGE_DEBUG=1
# Hardware decoding/encoding defaults to hardware first with software fallback.
# Change operating settings through a client. Retired transcoding environment
# overrides are rejected at runtime; the installer imports and retires them offline.
# Startup port overrides such as BRIDGE_GO2RTC_API_PORT remain supported.
